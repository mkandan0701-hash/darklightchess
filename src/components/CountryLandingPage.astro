---
// Renders one country page from src/data/markets.ts. Market-specific copy,
// time zones, proof and FAQs come from the data; this template only supplies
// structure, the course links and the enquiry form.
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import EnquiryForm from "./EnquiryForm.astro";
import BlogCard from "./BlogCard.astro";
import Img from "./Img.astro";
import FaqSchema from "./schema/FaqSchema.astro";
import { BRANCHES } from "../consts";
import type { Market } from "../data/markets";
import { HUB_PATH } from "../lib/seo";
import { currencies, inr, PRICE_INR_PER_HOUR } from "../data/pricing";
import { WHATSAPP_LINK } from "../consts";
import { describeDifference, formatOffset, formatTime, toIst } from "../lib/time";

interface Props {
  market: Market;
}

const { market } = Astro.props;

const exampleZone = market.timeZones.find((z) => z.zone === market.exampleZone);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const waText = encodeURIComponent(`Hi Darklight Chess Academy! I'm in ${market.countryName} and would like to book a free demo class.`);
const waHref = `${WHATSAPP_LINK}?text=${waText}`;
const lastUpdated = market.lastUpdated ? new Date(market.lastUpdated) : undefined;
const priceCurrencies = (market.currencies ?? []).map((c) => currencies[c]).filter(Boolean);

const levels = [
  { href: "/chess-classes-for-beginners/", name: "Beginners", text: "Rules, basic tactics and opening principles — age 5+ and adults." },
  { href: "/advanced-chess-training/", name: "Intermediate & Advanced", text: "Middlegame strategy, endgames and rating-focused training." },
  { href: "/tournament-chess-coaching/", name: "Tournament Preparation", text: "Game review and preparation for a specific event." },
  { href: "/one-to-one-chess-coaching/", name: "Private 1-to-1 Lessons", text: "A session built around one student's pace and goals." },
];
---

<BaseLayout
  title={market.title}
  description={market.description}
  path={market.path}
  locale={market.ogLocale}
>
  <PageHero
    eyebrow={market.eyebrow}
    title={market.heroTitle}
    subtitle={market.heroSubtitle}
    breadcrumbItems={[
      { name: "Home", path: "/" },
      { name: "Online Chess Classes", path: HUB_PATH },
      { name: market.countryName, path: market.path },
    ]}
  >
    <div class="hero-actions">
      <a href="#contact" class="btn btn-gold btn-lg book-btn" data-course="Free Demo Class">🗓️ Book a Free Demo Class</a>
      <a href="/coaches/" class="btn btn-outline btn-lg">Meet the Coaches</a>
    </div>
  </PageHero>

  {market.answer && (
    <section class="section answer-block">
      <div class="container narrow">
        <p class="answer-lead"><strong>{market.answer}</strong></p>
        {market.quickFacts && (
          <aside class="quick-facts" aria-label="Quick facts">
            <h2>Quick facts</h2>
            <ul class="check-list">
              {market.quickFacts.map((f) => <li set:html={f} />)}
            </ul>
          </aside>
        )}
        {lastUpdated && <p class="tz-note">Last updated: <time datetime={market.lastUpdated}>{lastUpdated.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time></p>}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container narrow">
      {market.intro.map((p) => <p set:html={p} />)}
    </div>
  </section>

  {(market.sections ?? []).map((sec) => (
    <section class="section">
      <div class="container narrow">
        <div class="section-head">
          <p class="eyebrow">{sec.eyebrow}</p>
          <h2>{sec.heading}</h2>
        </div>
        {sec.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </section>
  ))}

  {market.timeZones.length > 0 && (
    <section class="section bg-soft">
      <div class="container narrow">
        <div class="section-head">
          <p class="eyebrow">Scheduling</p>
          <h2>Class Times and Time Zones</h2>
        </div>
        <p>
          Classes are booked in your local time from the slots our coaches have open. Exact days and times are confirmed with you before the free demo — we don't publish a fixed timetable, because slots depend on your time zone and the student's level.
        </p>
        <div class="table-wrap">
          <table class="tz-table">
            <caption>Your time zone compared with India (IST, UTC+5:30)</caption>
            <thead>
              <tr><th scope="col">Time zone</th><th scope="col">Standard time</th><th scope="col">Daylight time</th></tr>
            </thead>
            <tbody>
              {market.timeZones.map((z) => (
                <tr>
                  <th scope="row">{z.zone}{z.note && <><br /><small class="tz-note">{z.note}</small></>}</th>
                  <td>{formatOffset(z.standard)} · {describeDifference(z.standard)}</td>
                  <td>{z.daylight !== undefined ? `${formatOffset(z.daylight)} · ${describeDifference(z.daylight)}` : "Not observed"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {exampleZone && market.examples.length > 0 && (
          <div class="table-wrap">
            <table class="tz-table">
              <caption>What a {exampleZone.zone} class time is in India</caption>
              <thead>
                <tr>
                  <th scope="col">Your time</th>
                  <th scope="col">{exampleZone.daylight !== undefined ? "In India, while you're on standard time" : "In India"}</th>
                  {exampleZone.daylight !== undefined && <th scope="col">In India, while you're on daylight time</th>}
                </tr>
              </thead>
              <tbody>
                {market.examples.map((ex) => (
                  <tr>
                    <th scope="row">{ex.day} {formatTime(ex.hour)}</th>
                    <td>{toIst(ex.day, ex.hour, exampleZone.standard)}</td>
                    {exampleZone.daylight !== undefined && <td>{toIst(ex.day, ex.hour, exampleZone.daylight)}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {market.dstNote && <p class="tz-note">{market.dstNote}</p>}
      </div>
    </section>
  )}

  {market.formMode === "Online (India)" && (
    <section class="section bg-soft">
      <div class="container narrow">
        <div class="section-head">
          <p class="eyebrow">Offline Option</p>
          <h2>Our Centres in Coimbatore</h2>
        </div>
        <p>All our physical classes are in Coimbatore. Everywhere else in India, students learn online on the same curriculum.</p>
        <ul class="check-list">
          {BRANCHES.map((b) => (
            <li><strong>{b.label}:</strong> {b.streetAddress}, {b.addressLocality}, {b.addressRegion} {b.postalCode}</li>
          ))}
        </ul>
        <p><a href="/chess-academy-coimbatore/">See our Coimbatore academy, directions and offline batches →</a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Programmes</p>
        <h2>Choose a Level</h2>
        <p class="section-sub">Not sure where your child fits? The free demo includes a level assessment, and we place them from there.</p>
      </div>
      <div class="market-links">
        {levels.map((l) => (
          <a href={l.href}>{l.name}<small>{l.text}</small></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Competing</p>
        <h2>{market.chessContext.heading}</h2>
      </div>
      {market.chessContext.paragraphs.map((p) => <p set:html={p} />)}
    </div>
  </section>

  {market.proof.items.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Proof, Not Promises</p>
          <h2>{market.proof.heading}</h2>
        </div>
        <div class="proof-grid">
          {market.proof.items.map((item) =>
            item.cite ? (
              <figure class="proof-card">
                <blockquote>“{item.text}”</blockquote>
                <figcaption>— {item.cite}</figcaption>
              </figure>
            ) : (
              <div class="proof-card">
                {item.image && <Img src={item.image} alt={item.imageAlt ?? item.text} />}
                <p>{item.text}</p>
              </div>
            )
          )}
        </div>
        <p style="text-align:center; margin-top:1.6rem;">
          <a href="/coaches/" class="card-learn-more">Meet the coaches behind these results →</a>
        </p>
      </div>
    </section>
  )}

  {priceCurrencies.length > 0 && (
    <section class="section">
      <div class="container narrow">
        <div class="section-head">
          <p class="eyebrow">Fees</p>
          <h2>How much do online chess lessons cost for families in {market.countryName}?</h2>
        </div>
        <p>
          Lessons start from <strong>{inr} per hour</strong>. Fees are set in Indian rupees, so the amount you pay in {priceCurrencies[0].label} depends on the exchange rate on the day. As a guide only, {inr} is {priceCurrencies.map((c) => `about ${c.symbol}${c.approx}`).join(" or ")} at recent rates. Siblings learning together get a discount, and the first demo class is free.
        </p>
        <p class="tz-note">Currency figures are indicative and rounded. Ask us for the exact amount when you enquire. Full details are on the <a href="/pricing/">pricing page</a>.</p>
      </div>
    </section>
  )}

  {market.answer && (
    <section class="section">
      <div class="container narrow">
        <div class="section-head">
          <p class="eyebrow">Choosing a Coach</p>
          <h2>Online academy, local club or marketplace tutor: which suits your child?</h2>
        </div>
        <div class="table-wrap">
          <table class="tz-table">
            <thead><tr><th scope="col"></th><th scope="col">Online academy (like us)</th><th scope="col">Local chess club</th><th scope="col">Marketplace tutor</th></tr></thead>
            <tbody>
              <tr><th scope="row">Curriculum</th><td>Structured levels from beginner to tournament prep</td><td>Often informal, varies by volunteer</td><td>Depends on the individual tutor</td></tr>
              <tr><th scope="row">Scheduling</th><td>Flexible, fitted around school and your time zone</td><td>Fixed weekly slot</td><td>Flexible, agreed per tutor</td></tr>
              <tr><th scope="row">Coaching team</th><td>Several coaches with national and international playing experience</td><td>One or two organisers</td><td>One person</td></tr>
              <tr><th scope="row">Playing in person</th><td>Not included; your child can still enter local events</td><td>Yes, face-to-face games</td><td>Not usually</td></tr>
            </tbody>
          </table>
        </div>
        <p>Many families do both: a local club for the social side, and an online academy for structured coaching. We are happy for your child to do either alongside our classes.</p>
      </div>
    </section>
  )}

  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Questions From Families in {market.countryName}</h2>
      </div>
      <div class="accordion">
        {market.faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
      <FaqSchema items={market.faqs} />
      <p style="margin-top:1.4rem;">
        More general questions — how online classes work, how often to attend, fees and tracking progress — are answered on our <a href={HUB_PATH}>online chess classes page</a>.
      </p>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="container">
      <div class="lead-grid">
        <div class="lead-copy">
          <p class="eyebrow">Free Demo Class</p>
          <h2>Book a Free Demo Class</h2>
          <p>The demo is free with no commitment. A coach assesses the student's level, and we suggest a batch or one-to-one slot that fits your time zone.</p>
          <p>{market.currencies ? <>Lessons start from {inr} per hour.</> : <>Fees depend on the format and how often the student attends, and we share them when you enquire.</>} Siblings learning together get a discount.</p>
          <p>Prefer to talk first? <a href={waHref} target="_blank" rel="noopener" data-whatsapp="country">Message us on WhatsApp</a> or use the button at the bottom of the screen.</p>
        </div>
        <EnquiryForm country={market.countryName} mode={market.formMode} />
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Further Reading</p>
          <h2>Guides From Our Coaches</h2>
        </div>
        <div class="cards-grid three blog-grid">
          {posts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              readTime={post.data.readTime}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

---
import { SITE_NAME, SITE_URL } from "../../consts";

interface Props {
  title: string;
  description: string;
  path: string;
  publishDate: Date;
  updatedDate?: Date;
  image?: string;
}

const { title, description, path, publishDate, updatedDate, image } = Astro.props;

const schema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: new URL(path, SITE_URL).toString(),
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  author: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
  },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
  },
};

if (image) {
  schema.image = new URL(image, SITE_URL).toString();
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

---
import { ORG_ID, SITE_NAME, SITE_URL } from "../../consts";

interface Props {
  title: string;
  description: string;
  path: string;
  publishDate: Date;
  updatedDate?: Date;
  image?: string;
  author?: string;
}

const { title, description, path, publishDate, updatedDate, image, author = SITE_NAME } = Astro.props;
const url = new URL(path, SITE_URL).toString();

const schema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  inLanguage: "en",
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  // Posts are attributed to the academy unless a named coach wrote them.
  author:
    author === SITE_NAME
      ? { "@id": ORG_ID }
      : { "@type": "Person", name: author, worksFor: { "@id": ORG_ID } },
  publisher: { "@id": ORG_ID },
};

if (image) {
  schema.image = new URL(image, SITE_URL).toString();
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

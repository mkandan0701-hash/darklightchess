---
import { ORG_ID, SITE_NAME, SITE_URL, WEBSITE_ID } from "../../consts";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: "en",
  publisher: { "@id": ORG_ID },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

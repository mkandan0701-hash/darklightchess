---
import { EMAIL, LOGO_PATH, PHONE_TEL, SITE_NAME, SITE_URL, SOCIALS } from "../../consts";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: SITE_URL,
  logo: new URL(LOGO_PATH, SITE_URL).toString(),
  email: EMAIL,
  telephone: PHONE_TEL,
  sameAs: Object.values(SOCIALS),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

---
import { LOGO_PATH } from "../consts";
import { imageSize } from "../lib/image-size";
import { levels } from "../data/levels";

const logo = imageSize(LOGO_PATH);
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
const before = [
  { href: "/about/", label: "About" },
  { href: "/coaches/", label: "Our Coaches" },
];
const after = [
  { href: "/achievements/", label: "Achievements" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];
---

<header class="navbar" id="navbar">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <img src={LOGO_PATH} alt="Darklight Chess Academy logo" width={logo.width} height={logo.height} />
      <span>Darklight <em>Chess Academy</em></span>
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Main">
      {before.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <div class="nav-drop">
        <a href="/courses/" aria-current={current("/courses/")}>Courses <span class="nav-caret" aria-hidden="true"></span></a>
        <div class="nav-menu">
          {levels.map((l) => (
            <a href={`/courses/${l.slug}/`}>
              <span class="nm-icon" aria-hidden="true">{l.icon}</span>
              <span class="nm-text"><strong>{l.name}</strong><small>Rating {l.rating} · Ages {l.age}</small></span>
            </a>
          ))}
        </div>
      </div>
      {after.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <a href="/contact/?course=Free%20Demo%20Class#contact" class="btn btn-gold nav-cta book-btn" data-course="Free Demo Class">Book a Free Demo</a>
    </nav>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

---
import Img from "./Img.astro";

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  readTime: string;
  image: string;
  imageAlt: string;
}

const { slug, title, description, category, readTime, image, imageAlt } = Astro.props;
---

<article class="blog-card reveal">
  <a href={`/blog/${slug}/`} class="blog-thumb">
    <Img src={image} alt={imageAlt} />
  </a>
  <div class="blog-body">
    <p class="blog-meta">{category} · {readTime}</p>
    <h3><a href={`/blog/${slug}/`}>{title}</a></h3>
    <p>{description}</p>
    <a href={`/blog/${slug}/`} class="btn-link">Read Article →</a>
  </div>
</article>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBanner from "../components/CtaBanner.astro";
import LevelCard from "../components/LevelCard.astro";
import FaqSchema from "../components/schema/FaqSchema.astro";
import { levels } from "../data/levels";

const faqs = [
  {
    question: "How do I know which level my child should join?",
    answer:
      "Book a free demo class. The coach plays and talks with your child, assesses their level, and recommends the right starting point.",
  },
  {
    question: "Can we move up a level later?",
    answer:
      "Yes. Students move up as their play improves, and coaches review progress regularly so the next level is always the right fit.",
  },
  {
    question: "Are classes online or in person?",
    answer:
      "Both. Classes run live online for students worldwide and offline at our two centres in Coimbatore.",
  },
];
---

<BaseLayout
  title="Chess Courses & Levels | Darklight Chess Academy"
  description="Five chess levels from beginner to master with ages, ratings, durations and live class counts, online and in Coimbatore. Book a free demo class."
  path="/courses/"
>
  <PageHero
    eyebrow="Our Courses"
    title="From First Move to <span class='gold'>Chess Excellence.</span>"
    subtitle="Structured chess training for every stage of your child's journey."
    breadcrumbItems={[
      { name: "Home", path: "/" },
      { name: "Courses", path: "/courses/" },
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Five Levels</p>
        <h2>Learn at the Right Level</h2>
        <p class="section-sub">Students progress through levels based on their skills, understanding and a coach's assessment. Not sure where to start? Book a free demo and we'll recommend a level.</p>
      </div>
      <div class="level-grid">
        {levels.map((l) => <LevelCard level={l} />)}
      </div>
    </div>
  </section>

  <section class="section bg-soft" id="compare">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Compare</p>
        <h2>Find the Right Chess Level</h2>
      </div>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead><tr><th>Level</th><th>Age</th><th>Rating</th><th>Duration</th><th>Live Sessions</th></tr></thead>
          <tbody>
            {levels.map((l) => (
              <tr>
                <td data-label="Level"><a href={`/courses/${l.slug}/`}>{l.step}. {l.name}</a></td>
                <td data-label="Age">{l.age}</td>
                <td data-label="Rating">{l.rating}</td>
                <td data-label="Duration">{l.duration}</td>
                <td data-label="Live Sessions">{l.sessionsShort}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Choosing a Level</h2>
      </div>
      <div class="accordion">
        {faqs.map((f) => (
          <details><summary>{f.question}</summary><p>{f.answer}</p></details>
        ))}
      </div>
      <FaqSchema items={faqs} />
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <CtaBanner
        heading="Ready to Make the First Move?"
        subtext="Book a free demo class. We'll assess your level and recommend where to start. No commitment."
        course="Free Demo Class"
      />
    </div>
  </section>
</BaseLayout>

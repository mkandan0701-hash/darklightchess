---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import FaqSchema from "../components/schema/FaqSchema.astro";
import GlobalPresence from "../components/GlobalPresence.astro";
import Partners from "../components/Partners.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import Img from "../components/Img.astro";
import CtaBanner from "../components/CtaBanner.astro";
import PersonCard from "../components/PersonCard.astro";
import { coaches } from "../data/coaches";
import { stats } from "../data/stats";
import { homeFaqs } from "../data/faq-home";
import { levels } from "../data/levels";

const why = [
  { title: "Expert Coaching", text: "Learn from FIDE-rated coaches and certified trainers shaping chess talent across India and internationally.", href: "/coaches/", image: "/assets/images/gallery-c1.jpg", alt: "Darklight coach at a tournament board" },
  { title: "Online Coaching", text: "Interactive live classes tailored to your needs, accessible from anywhere in the world.", href: "/online-chess-classes/", image: "/assets/images/gallery-a15.jpg", alt: "Student in a live online chess class on a laptop" },
  { title: "Offline Classes", text: "Face-to-face learning with personal attention at our Coimbatore centres.", href: "/chess-academy-coimbatore/", image: "/assets/images/class-photo.jpg", alt: "Chess class in progress at the academy" },
  { title: "Group & Individual Classes", text: "Learn with chess buddies, or choose one-on-one coaching for a tailored experience.", href: "/one-to-one-chess-coaching/", image: "/assets/images/outdoor-event.jpg", alt: "Students playing chess together at an outdoor event" },
  { title: "Tournaments & Events", text: "Academy tournaments help students learn from mistakes and compete with confidence.", href: "/tournament-chess-coaching/", image: "/assets/images/gallery-b1.jpg", alt: "Young Darklight student holding a trophy and medal" },
  { title: "Every Age, Every Level", text: "Tailored courses for children and adults. Age is no barrier to learning chess.", href: "/chess-classes-for-kids-coimbatore/", image: "/assets/images/hero-kid-web.jpg", alt: "Young child playing chess" },
];

const benefits = [
  { icon: "♟\uFE0E", title: "Focus", text: "Holding one position in mind for a whole game trains sustained attention." },
  { icon: "♞", title: "Problem-Solving", text: "Every move is a small puzzle: weigh options, spot risks, choose a plan." },
  { icon: "♝", title: "Memory & Logic", text: "Patterns, openings and calculation exercise memory and logical thinking." },
  { icon: "♜", title: "Patience", text: "Good moves take time. Students learn to slow down and think before acting." },
  { icon: "♛", title: "Confidence", text: "Winning, losing and learning from both builds resilience and self-belief." },
  { icon: "♚", title: "Productive Screen Time", text: "Live, coach-led classes keep online time active and purposeful." },
];
---

<BaseLayout
  title="Darklight Chess Academy | Online Chess Academy & Coaching"
  description="Live online chess classes for kids and adults worldwide with FIDE-rated coaches, from beginner to tournament level — plus offline centres in Coimbatore. Free demo."
  path="/"
  preloadImage="/assets/images/hero-academy-students.jpg"
  includeLocalBusinessSchema={true}
>
  <!-- ============ HERO + BOOKING FORM ============ -->
  <section class="home-hero" id="home">
    <Img src="/assets/images/hero-academy-students.jpg" alt="Students in a class at Darklight Chess Academy, seated with their notebooks in front of the academy banner" class="home-hero-bg" eager fetchpriority="high" />
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="hero-pill">♞ Live online chess coaching, trusted worldwide</p>
        <h1><span class="gold">Online Chess Coaching</span> That Builds Champions</h1>
        <p class="hero-sub">One of our students recently won a chess tournament in Canada, coached entirely online by our FIDE-rated trainers. Join live 1-on-1 or group classes from anywhere, or visit our centres in Coimbatore.</p>
        <ul class="hero-points">
          <li><span aria-hidden="true">♚</span> 1-on-1 or group classes with FIDE-rated coaches</li>
          <li><span aria-hidden="true">♞</span> Five clear levels, from first move to tournament play</li>
          <li><span aria-hidden="true">♜</span> Online worldwide, offline in Coimbatore</li>
        </ul>
        <a href="#courses" class="btn btn-outline btn-lg">Explore Courses →</a>
        <p class="hero-note">Free demo class · No cost, no commitment · <a href="/contact/">Addresses, phone &amp; maps</a></p>
      </div>
      <div id="contact">
        <EnquiryForm heading="Book a free demo or enrol" />
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="stats" id="stats">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat reveal">
          <span class="stat-num" data-count={s.value}>{s.value}</span><span class="stat-plus">+</span>
          <p>{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ WHY CHOOSE US ============ -->
  <section class="section bg-soft" id="why">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Why Darklight?</p>
        <h2>We Don't Just Coach. We Build Confidence.</h2>
        <p class="section-sub">Darklight Chess Academy, based in Tamil Nadu, India, is a growing hub for chess players of all levels. Our mission is to make world-class chess coaching accessible to everyone, anywhere, with structured training, personal mentorship and performance-driven coaching.</p>
        <div class="section-actions">
          <a href="/contact/?course=Free%20Demo%20Class#contact" class="btn btn-gold book-btn" data-course="Free Demo Class">Book a Free Demo Class</a>
          <a href="/about/" class="btn btn-ghost">About the Academy →</a>
        </div>
      </div>
      <div class="photo-cards">
        {why.map((w, i) => (
          <a class="photo-card reveal" href={w.href}>
            <div class="photo-card-img">
              <Img src={w.image} alt={w.alt} />
              <span class="photo-num">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="photo-card-body">
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="band-gap">
        <CtaBanner
          heading="Ready to Make the First Move?"
          subtext="Tell us the student's age and chess experience, and we'll find the right starting point."
          course="Free Demo Class"
        />
      </div>
    </div>
  </section>

  <!-- ============ COURSES ============ -->
  <section class="section checker" id="courses">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow light">The Curriculum</p>
        <h2 class="light-title">Five Levels. One Clear Path.</h2>
        <p class="section-sub light-sub">Every student starts with a level assessment and moves up through clear milestones, online worldwide or at our Coimbatore centres.</p>
      </div>
      <div class="curriculum">
        {levels.map((l) => (
          <a class="curriculum-card reveal" href={`/courses/${l.slug}/`}>
            <span class="curriculum-top"><span>Level {l.step}</span><span class="curriculum-icon" aria-hidden="true">{l.icon}</span></span>
            <h3>{l.name}</h3>
            <span class="curriculum-rating">Rating {l.rating}</span>
            <p>{l.summary}</p>
            <span class="curriculum-more">View syllabus →</span>
          </a>
        ))}
      </div>
      <div class="program-links on-dark reveal">
        <a href="/online-chess-classes/">Online Classes for Kids</a>
        <a href="/chess-classes-for-beginners/">Beginner Classes</a>
        <a href="/advanced-chess-training/">Intermediate &amp; Advanced</a>
        <a href="/tournament-chess-coaching/">Tournament Preparation</a>
        <a href="/one-to-one-chess-coaching/">Private 1-to-1 Lessons</a>
        <a href="/chess-academy-coimbatore/">Chess Academy in Coimbatore</a>
        <a href="/chess-classes-for-kids-coimbatore/">Kids Classes in Coimbatore</a>
      </div>
      <div class="sibling-note reveal">
        <div>
          <h3>Sibling Classes: Learn Together, Save Together</h3>
          <p>Sibling classes come with special discounts, so brothers, sisters and cousins can build their skills side by side.</p>
        </div>
        <a href="/contact/?course=Sibling%20Class#contact" class="btn btn-gold book-btn" data-course="Sibling Class">Enquire About Sibling Classes</a>
      </div>
    </div>
  </section>

  <!-- ============ COACHES ============ -->
  <section class="section" id="coaches">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Meet Our Coaches</p>
        <h2>FIDE-Rated Coaches &amp; Certified Trainers</h2>
        <p class="section-sub">Shaping top chess talent across India and internationally at Darklight Chess Academy.</p>
      </div>
      <div class="people-grid">
        {coaches.map((c) => <PersonCard person={c} />)}
      </div>
      <p class="ladder-more"><a href="/coaches/" class="btn btn-dark">Meet All Our Coaches →</a></p>
    </div>
  </section>

  <!-- ============ TESTIMONIALS PREVIEW ============ -->
  <section class="section testimonials bg-soft" id="testimonials">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What Our Students Say</p>
        <h2>Real Success Stories From India and Abroad</h2>
        <p class="section-sub">Students who have improved through Darklight Chess Academy's expert coaching.</p>
      </div>
      <div class="cards-grid three">
        <figure class="t-card reveal">
          <div class="t-quote">❝</div>
          <blockquote>My son attends from Dubai via online sessions. The improvement is visible. We love how interactive the classes are.</blockquote>
          <figcaption>— Fatima A., UAE</figcaption>
        </figure>
        <figure class="t-card reveal">
          <div class="t-quote">❝</div>
          <blockquote>I'm from the UK, and the timezone-friendly online batch fits perfectly. I'm now confidently playing in local UK tournaments.</blockquote>
          <figcaption>— Raj Patel, London</figcaption>
        </figure>
        <figure class="t-card reveal">
          <div class="t-quote">❝</div>
          <blockquote>After trying multiple platforms, I found Darklight to be the most structured and professional.</blockquote>
          <figcaption>— Preeti Sharma, Delhi</figcaption>
        </figure>
      </div>
      <p class="ladder-more reveal"><a href="/achievements/" class="btn-link">More success stories →</a></p>
    </div>
  </section>


  <!-- ============ GLOBAL PRESENCE ============ -->
  <GlobalPresence />

  <!-- ============ HOW TO ENROLL ============ -->
  <section class="section enroll" id="enroll">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Getting Started</p>
        <h2>Let's Get You Started!</h2>
        <p class="section-sub">Book a free demo to get to know Darklight coaching and to assess your level in chess — at no cost!</p>
      </div>
      <div class="steps">
        <div class="step reveal">
          <span class="step-num">1</span>
          <h3>Book a Free Demo</h3>
          <p>Fill the form below and pick a slot. Experience our coaching firsthand.</p>
        </div>
        <div class="step reveal">
          <span class="step-num">2</span>
          <h3>Level Assessment</h3>
          <p>Our coaches analyse and assess your game to place you at the right level.</p>
        </div>
        <div class="step reveal">
          <span class="step-num">3</span>
          <h3>Choose Your Batch</h3>
          <p>Weekday or weekend, group or 1-on-1, online or offline — your pace, your style.</p>
        </div>
        <div class="step reveal">
          <span class="step-num">4</span>
          <h3>Start Learning</h3>
          <p>Begin structured training with personalized mentorship and visible progress.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BENEFITS ============ -->
  <section class="section bg-soft" id="benefits">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Beyond the Board</p>
        <h2>What Chess Builds in Your Child</h2>
        <p class="section-sub">Chess is a game, but the habits it builds carry into school and life.</p>
      </div>
      <div class="cards-grid three">
        {benefits.map((b) => (
          <div class="feature-card reveal">
            <div class="icon-tile" aria-hidden="true">{b.icon}</div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GALLERY PREVIEW ============ -->
  <section class="section" id="gallery">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Gallery</p>
        <h2>Representing Darklight Across the Board</h2>
        <p class="section-sub">Real moments from our classes, tournaments and events.</p>
      </div>
      <div class="photo-strip reveal">
        <Img src="/assets/images/gallery-a1.jpg" alt="Darklight students at a chess tournament" />
        <Img src="/assets/images/gallery-a7.jpg" alt="Team Darklight at a tournament venue" />
        <Img src="/assets/images/class-photo.jpg" alt="Chess class in progress at the academy" />
        <Img src="/assets/images/outdoor-event.jpg" alt="Outdoor chess event with young players" />
        <Img src="/assets/images/gallery-b1.jpg" alt="Young Darklight student holding a trophy and medal" />
      </div>
      <p class="ladder-more reveal"><a href="/gallery/" class="btn btn-ghost">View Full Gallery →</a></p>
    </div>
  </section>

  <!-- ============ PARTNERS ============ -->
  <Partners />

  <!-- ============ BLOG ============ -->
  <section class="section blog" id="blog">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Our Blog</p>
        <h2>Chess Wisdom From Our Coaches</h2>
        <p class="section-sub">Tips, guides and insights to help every parent and player make the right move.</p>
      </div>
      <div class="cards-grid three blog-grid">
        <BlogCard
          slug="5-opening-principles-every-beginner-should-master"
          title="5 Opening Principles Every Beginner Should Master"
          description="Before memorising any opening lines, every new player needs these five habits that decide most beginner games…"
          category="Beginners"
          readTime="4 min read"
          image="/assets/images/stock1.jpg"
          imageAlt="Chess opening principles illustration"
        />
        <BlogCard
          slug="how-tournaments-build-your-childs-confidence"
          title="How Tournaments Build Your Child's Confidence"
          description="Wins are great, but the real growth happens between the rounds. Here's what competition actually teaches kids…"
          category="For Parents"
          readTime="3 min read"
          image="/assets/images/stock4.jpg"
          imageAlt="Two players at a chess board illustration"
        />
        <BlogCard
          slug="online-vs-offline-chess-classes-coimbatore"
          title="Online vs Offline Chess Classes: Which Is Right for You?"
          description="We teach both, every week. Here's an honest comparison to help you pick the format that fits your family…"
          category="Guides"
          readTime="4 min read"
          image="/assets/images/webinar.png"
          imageAlt="Online chess class illustration"
        />
      </div>
      <p style="text-align:center; margin-top:2.4rem;">
        <a href="/blog/" class="btn btn-purple">View All Articles</a>
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section faq bg-soft" id="faq">
    <div class="container narrow">
      <div class="section-head reveal">
        <p class="eyebrow">FAQ</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="accordion reveal" id="accordion">
        {homeFaqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <FaqSchema items={homeFaqs} />

  <section class="section">
    <div class="container">
      <CtaBanner
        heading="Every Move Matters. Make Yours."
        subtext="Book a free demo class. We'll assess the student's level and recommend where to start."
        course="Free Demo Class"
      />
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FaqSchema from "../components/schema/FaqSchema.astro";
import CourseSchema from "../components/schema/CourseSchema.astro";

const faqs = [
  {
    question: "What is the best age to start chess coaching?",
    answer:
      "Many children are ready for structured chess classes from about age 5, and we have taught children as young as 4–6 — there's no upper age limit, and adults start from scratch with us too. Readiness matters more than age: a child who can concentrate on a short activity and follow simple rules is usually ready for a beginner class.",
  },
  {
    question: "Can beginners learn chess online?",
    answer:
      "Yes. The beginner track runs live online on the same curriculum as our offline classes, and no prior knowledge is assumed. A coach demonstrates each idea on a shared digital board, students practise it straight away in class, and mistakes are corrected as they happen.",
  },
  {
    question: "I've never played chess. Can I still join?",
    answer:
      "Yes — this track is built specifically for complete beginners, whether you're a child or an adult. No prior experience or knowledge of the rules is assumed.",
  },
  {
    question: "How long does it take to go from beginner to playing confidently?",
    answer:
      "It varies by how often you practice, but most students who attend classes consistently and do the weekly puzzle homework can play a full, sensible game within a few months.",
  },
  {
    question: "Do beginners need their own chess set or board?",
    answer:
      "It helps to have a basic set at home for practice, but it isn't required to start — the class itself provides everything you need, and we'll guide you on simple tools for practicing between sessions.",
  },
];
---

<BaseLayout
  title="Chess Classes for Beginners, Online | Darklight Chess Academy"
  description="Online chess classes for complete beginners — kids from age 5 and adults. Learn the rules, basic tactics and opening principles live with a coach. Free demo class."
  path="/chess-classes-for-beginners/"
>
  <CourseSchema
    name="Beginner Chess Classes"
    description="Live chess classes for complete beginners, children and adults: rules and piece movement, basic tactics and opening principles."
    path="/chess-classes-for-beginners/"
    modes={["online", "onsite"]}
    educationalLevel="Beginner"
  />
  <PageHero
    eyebrow="Start Here"
    title="Chess Classes for <span class='gold'>Beginners</span>"
    subtitle="A structured, no-pressure start to chess — for children and adults alike, live online from anywhere or at our Coimbatore centres."
    breadcrumbItems={[
      { name: "Home", path: "/" },
      { name: "Online Chess Classes", path: "/online-chess-classes/" },
      { name: "Chess Classes for Beginners", path: "/chess-classes-for-beginners/" },
    ]}
  />

  <section class="section">
    <div class="container narrow">
      <p>
        Starting chess as a total beginner can feel intimidating, especially watching others who already "know how to play." Our beginner track exists specifically to remove that gap — everyone in the batch starts from the same place, and the curriculum is built so each class adds exactly one new idea rather than assuming prior knowledge.
      </p>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What You'll Learn</p>
        <h2>The Beginner Curriculum</h2>
      </div>
      <div class="cards-grid three">
        <div class="feature-card">
          <div class="feature-icon">♟</div>
          <h3>Rules &amp; Piece Movement</h3>
          <p>How each piece moves and captures, check and checkmate, castling, and other basic rules — taught through play, not memorisation.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎯</div>
          <h3>Basic Tactics</h3>
          <p>Forks, pins and simple combinations — the patterns that decide most beginner-level games.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🧭</div>
          <h3>Opening Principles</h3>
          <p>Controlling the centre, developing pieces early and castling on time — see our full breakdown in the blog below.</p>
        </div>
      </div>
      <p style="text-align:center; margin-top:2rem;">
        <a href="/blog/5-opening-principles-every-beginner-should-master/" class="card-learn-more">Read: 5 Opening Principles Every Beginner Should Master →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Who This Is For</p>
        <h2>Kids and Adults, Same Structured Start</h2>
      </div>
      <p>
        We run beginner batches for children as well as adults who are picking up chess for the first time — the pace and structure adapt, but the same principle applies: one idea at a time, with plenty of guided practice. If your beginner is a child, our <a href="/online-chess-classes/">online chess classes for kids</a> page answers the questions parents ask most. When you're ready for more competitive play, the natural next step is <a href="/advanced-chess-training/">intermediate and advanced training</a> or, for tournament ambitions, <a href="/tournament-chess-coaching/">tournament preparation</a>.
      </p>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Format</p>
        <h2>Learn Online, or In Person in Coimbatore</h2>
      </div>
      <p>
        Beginner classes run <a href="/online-chess-classes/">live online</a> for students anywhere, and <a href="/chess-academy-coimbatore/">offline at our Coimbatore centres</a>, on identical material. If you'd rather have completely individual pacing instead of a group batch, our <a href="/one-to-one-chess-coaching/">one-to-one coaching</a> is also available from day one.
      </p>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="accordion">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
      <FaqSchema items={faqs} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBanner
        heading="Take Your First Class, Free"
        subtext="Book a free demo class — no prior experience needed, and no pressure to continue if it isn't the right fit."
        course="Beginner Level"
      />
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BlogCard from "../../components/BlogCard.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Chess Blog | Tips for Parents & Players | Darklight Chess Academy"
  description="Chess guides for parents and players from Darklight Chess Academy's coaches — fundamentals, online coaching, tournament preparation and helping children improve."
  path="/blog/"
>
  <PageHero
    eyebrow="Our Blog"
    title="Chess Wisdom From <span class='gold'>Our Coaches</span>"
    subtitle="Tips, guides and insights to help every parent and player make the right move — on the fundamentals, online coaching and tournament preparation."
    breadcrumbItems={[
      { name: "Home", path: "/" },
      { name: "Blog", path: "/blog/" },
    ]}
  />

  <section class="section">
    <div class="container">
      <p style="text-align:center; max-width:720px; margin:0 auto 2.2rem;">
        Written by our coaching team for parents and players. Looking for classes? See our <a href="/online-chess-classes/" style="color:var(--purple); font-weight:600;">online chess classes</a>, <a href="/chess-classes-for-beginners/" style="color:var(--purple); font-weight:600;">beginner classes</a> or <a href="/tournament-chess-coaching/" style="color:var(--purple); font-weight:600;">tournament preparation</a>.
      </p>
      {posts.length === 0 ? (
        <p style="text-align:center; color:var(--muted);">New articles are on the way — check back soon.</p>
      ) : (
        <div class="cards-grid three blog-grid">
          {posts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              readTime={post.data.readTime}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

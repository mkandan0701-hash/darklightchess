---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBanner from "../components/CtaBanner.astro";
import AnswerFirst from "../components/AnswerFirst.astro";
import UsFamilies from "../components/UsFamilies.astro";
import FaqSchema from "../components/schema/FaqSchema.astro";
import CourseSchema from "../components/schema/CourseSchema.astro";

const faqs = [
  {
    question: "How can kids prepare for chess tournaments?",
    answer:
      "Play a low-pressure event first, practice with a chess clock, and learn tournament rules such as touch-move and recording moves before the day. In the weeks before, focus on tactics and simple endgames rather than new openings, and review every tournament game with a coach afterwards so the experience turns into lessons, whatever the result.",
  },
  {
    question: "Does my child need a US Chess membership to play tournaments?",
    answer:
      "For US Chess-rated tournaments, yes: each player needs a current US Chess membership, and their first rated games give them a provisional rating. Many school and club events are rated this way. Some casual or unrated events don't require membership, so check each tournament's entry details.",
  },
  {
    question: "My child has never played a tournament. Is this track too advanced?",
    answer:
      "Not necessarily. We usually start students with a low-pressure academy tournament before open or rated events, so the first competitive experience isn't overwhelming.",
  },
  {
    question: "Do you help students prepare for a specific upcoming tournament?",
    answer:
      "Yes. Coaches can plan sessions around an event a student has entered, including scholastic and US Chess-rated tournaments, alongside the regular curriculum, then review the games afterwards.",
  },
  {
    question: "What does tournament chess coaching cover?",
    answer:
      "Rating-focused practice, positional understanding, endgame technique, clock management and review of the student's own played games to find recurring mistakes under real conditions, not just puzzles.",
  },
  {
    question: "Is tournament coaching available online?",
    answer:
      "Yes. Tournament preparation runs online for students anywhere, and offline at our Coimbatore centres, including game-review sessions over video call.",
  },
];

const description =
  "Chess coaching for tournament players, live online: rating-focused training, game review and preparation for US Chess-rated and scholastic events. Free chess assessment.";
const lead =
  "Darklight Chess Academy coaches tournament players live online, from a child's first scholastic event to rated play. Coaches review the student's own tournament games, train the endgames and positions that decide results, and plan preparation for a specific event. Our students' US results include 1st place at the USA Chess Festival. The first session, a chess assessment, is free.";
---

<BaseLayout
  title="Chess Coaching for Tournament Players, Online | Darklight Chess Academy"
  description={description}
  path="/tournament-chess-coaching/"
>
  <CourseSchema
    name="Tournament Chess Preparation"
    description="Rating-focused chess coaching for competitive students: positional play, endgames, review of the student's own tournament games and preparation for specific events."
    path="/tournament-chess-coaching/"
    modes={["online", "onsite"]}
    educationalLevel="Intermediate to advanced"
  />
  <PageHero
    eyebrow="Competitive Chess"
    title="Chess Coaching for <span class='gold'>Tournament Players</span>"
    subtitle="Rating-focused coaching for students preparing to compete, online from anywhere or in Coimbatore, with academy tournaments as a stepping stone to bigger events."
    breadcrumbItems={[
      { name: "Home", path: "/" },
      { name: "Online Chess Classes", path: "/online-chess-classes/" },
      { name: "Tournament Preparation", path: "/tournament-chess-coaching/" },
    ]}
  >
    <div class="hero-actions">
      <a href="/contact/?course=Advanced%20Level#contact" class="btn btn-gold btn-lg book-btn" data-course="Advanced Level">Book a Free Chess Assessment</a>
      <a href="#faq" class="btn btn-outline btn-lg">Parents' Questions</a>
    </div>
  </PageHero>

  <AnswerFirst
    lead={lead}
    facts={[
      { label: "Who it's for", text: "students who know the rules and basic tactics and want better competitive results" },
      { label: "Covers", text: "game review, endgames, positional play, clock management, event preparation" },
      { label: "US events", text: "US Chess-rated and scholastic tournaments; <a href=\"/blog/us-chess-ratings-explained-for-parents/\">US Chess ratings explained</a>" },
      { label: "Format", text: "live online group or <a href=\"/one-to-one-chess-coaching/\">private 1-to-1</a>" },
      { label: "First step", text: "a free chess assessment with a coach" },
    ]}
  />

  <section class="section bg-soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What's Covered</p>
        <h2>Inside Tournament Chess Coaching</h2>
        <p class="section-sub">Playing well in casual games and playing well under tournament conditions are different skills. This track is for students who know the fundamentals and want better competitive results.</p>
      </div>
      <div class="cards-grid three">
        <div class="feature-card">
          <div class="feature-icon">🔍</div>
          <h3>Review of Their Own Games</h3>
          <p>Coaches go through the student's tournament games to find the mistakes that keep costing points under pressure.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">♛</div>
          <h3>Positional Play &amp; Endgames</h3>
          <p>The strategy and endgame technique that turn tactically sharp players into consistently strong competitors.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⏱️</div>
          <h3>Event Preparation</h3>
          <p>A plan for the weeks before an event: clock practice, an opening repertoire that suits the child, and rest before the day.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">In the US</p>
        <h2>Preparing for US Chess-Rated and Scholastic Tournaments</h2>
      </div>
      <p>
        Many US children start competing at scholastic tournaments, often organized by grade, and at US Chess-rated club events. Rated play needs a US Chess membership; a child's first rated games give them a provisional rating that settles as they play more. Our guide to <a href="/blog/us-chess-ratings-explained-for-parents/">US Chess ratings for parents</a> explains how it works.
      </p>
      <p>
        Coaches help with the practical side as well as the chess: using a clock, touch-move, recording moves, and what to do between rounds. Our students' US results include 1st place at the USA Chess Festival and a state-level championship title. See <a href="/online-chess-classes-usa/">online chess classes in the USA</a> for time zones and US results, or <a href="/online-chess-classes-canada/">Canada</a> for CFC-rated play.
      </p>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">Getting Competitive Experience</p>
        <h2>Academy Tournaments as a Stepping Stone</h2>
      </div>
      <p>
        We run regular academy tournaments so students get real competitive experience (an unfamiliar opponent, a clock, handling a loss) in a familiar, encouraging setting before they enter open or rated events. For a parent's view of why this staged approach matters, read <a href="/blog/how-tournaments-build-your-childs-confidence/">how tournaments build your child's confidence</a>.
      </p>
      <p>
        This track builds on our <a href="/advanced-chess-training/">intermediate and advanced training</a>. If your child is newer to chess, start with <a href="/chess-classes-for-beginners/">beginner classes</a>.
      </p>
    </div>
  </section>

  <UsFamilies />

  <section class="section" id="faq">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Tournament Chess Coaching: Questions Parents Ask</h2>
      </div>
      <div class="accordion">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
      <FaqSchema items={faqs} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBanner
        heading="Get Tournament-Ready"
        subtext="Book a free chess assessment and talk to a coach about your (or your child's) tournament goals."
        course="Advanced Level"
      />
    </div>
  </section>
</BaseLayout>
